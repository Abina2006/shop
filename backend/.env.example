# Backend Deployment Environment Variables Example
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection URL (Render, Supabase, Neon, Railway)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Configurable Price Staleness Threshold (in minutes, default: 180 = 3 hours)
PRICE_STALE_AFTER_MINUTES=180

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Real Marketplace API Keys for Live Automated Price Fetching
AMAZON_PAAPI_KEY=your_amazon_paapi_key_here
FLIPKART_AFFILIATE_KEY=your_flipkart_affiliate_key_here
MEESHO_API_KEY=your_meesho_api_key_here
CROMA_API_KEY=your_croma_api_key_here
MYNTRA_API_KEY=your_myntra_api_key_here
PRICE_API_KEY=your_price_api_key_here

# (Optional) SMTP Email Configuration for Price Drop Alerts
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
